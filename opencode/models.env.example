# SGLang workflow routing configuration. Copied to ~/.config/sglang-workflow/models.env.
# Keep mode 0600. Do not commit credentials.

AI_PRIMARY_HARNESS=codex
AI_PRIMARY_PROVIDER=openai
# Legacy compatibility field used by v0.2 and external-primary setups.
AI_PRIMARY_BACKEND=codex
AI_ROUTING_MODE=primary
AI_ENABLE_CODEX_FALLBACK=0

# Codex provider policy: balanced | openai | glm
AI_CODEX_ROUTING=balanced

# GLM Coding Plan inside Codex. China = BigModel, global = Z.AI.
AI_GLM_ENABLED=0
AI_GLM_REGION=china
AI_GLM_BASE_URL=https://open.bigmodel.cn/api/v1
AI_GLM_MODEL=glm-5.3
AI_GLM_API_KEY=

# Optional self-hosted worker (OpenCode only).
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=not-needed
AI_LOCAL_NPM=@ai-sdk/openai-compatible
AI_LOCAL_CONTEXT=131072
AI_LOCAL_OUTPUT=16384

# Optional low-cost external worker (OpenCode only).
AI_CHEAP_BASE_URL=
AI_CHEAP_MODEL=
AI_CHEAP_API_KEY=
AI_CHEAP_NPM=@ai-sdk/openai-compatible
AI_CHEAP_CONTEXT=262144
AI_CHEAP_OUTPUT=32768

# Optional stronger external worker (OpenCode only).
AI_STRONG_BASE_URL=
AI_STRONG_MODEL=
AI_STRONG_API_KEY=
AI_STRONG_NPM=@ai-sdk/openai-compatible
AI_STRONG_CONTEXT=262144
AI_STRONG_OUTPUT=32768

AI_OPENCODE_AUTO=1
