# SGLang workflow model routing configuration.
# This file is copied to ~/.config/sglang-workflow/models.env.
# External model/API settings are optional. Shell exports override this file.

# Primary backend used by `ai-task` in primary routing mode.
# Values: codex | local | cheap | strong | none
AI_PRIMARY_BACKEND=codex

# primary: every automatic task goes to the selected primary backend.
# hybrid: cost-sensitive tasks may use workers; correctness-sensitive SGLang/Ascend tasks keep the selected primary first.
AI_ROUTING_MODE=primary

# When the primary backend is not Codex, hybrid mode will use Codex only if this is enabled.
AI_ENABLE_CODEX_FALLBACK=0

# Tier 0: optional self-hosted OpenAI-compatible worker (vLLM/SGLang/llama.cpp/Ollama/gateway).
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=not-needed
AI_LOCAL_NPM=@ai-sdk/openai-compatible
AI_LOCAL_CONTEXT=131072
AI_LOCAL_OUTPUT=16384

# Tier 1: optional low-cost OpenAI-compatible cloud worker.
AI_CHEAP_BASE_URL=
AI_CHEAP_MODEL=
AI_CHEAP_API_KEY=
AI_CHEAP_NPM=@ai-sdk/openai-compatible
AI_CHEAP_CONTEXT=262144
AI_CHEAP_OUTPUT=32768

# Tier 2: optional stronger OpenAI-compatible cloud worker/reviewer.
AI_STRONG_BASE_URL=
AI_STRONG_MODEL=
AI_STRONG_API_KEY=
AI_STRONG_NPM=@ai-sdk/openai-compatible
AI_STRONG_CONTEXT=262144
AI_STRONG_OUTPUT=32768

AI_OPENCODE_AUTO=1
