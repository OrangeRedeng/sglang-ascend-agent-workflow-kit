#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys


def run(cmd: list[str], cwd: Path | None = None, timeout: int = 240, required: bool = True) -> int:
    print("+ " + " ".join(cmd))
    try:
        p = subprocess.run(cmd, cwd=cwd, timeout=timeout, check=False)
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1 if required else 0
    if p.returncode and required:
        print(f"FAILED ({p.returncode}): {' '.join(cmd)}", file=sys.stderr)
    return 0 if p.returncode == 0 else 1


def tool(name: str) -> str:
    found = shutil.which(name)
    if found:
        return found
    return str(Path(__file__).resolve().parent / name)


def workspace(value: str | None) -> Path:
    return Path(value or os.environ.get("SGLANG", str(Path.home() / "code/sglang"))).expanduser().resolve()


def doctor(root: Path) -> int:
    failures = 0
    print("\n==> Copilot unified UI")
    failures += run([tool("workflow-copilot"), "doctor", "--workspace", str(root)], cwd=root)
    print("\n==> Codex fallback")
    # CLI health is useful but does not block Copilot Chat. Repair is attempted during setup.
    run([tool("workflow-codex"), "doctor"], cwd=root, required=False)
    print("\n==> Skills")
    failures += run([tool("workflow-skills"), "dedupe", "--workspace", str(root)], cwd=root)
    failures += run([tool("workflow-skills"), "status", "--installed-only"], cwd=root)
    print("\n==> Workspace")
    failures += run([sys.executable, ".codex/scripts/workflow-doctor.py"], cwd=root)
    if failures:
        print(f"\nDoctor summary: {failures} check group(s) failed.", file=sys.stderr)
        return 1
    print("\nDoctor summary: all automatable checks passed.")
    print("Manual once: Codex Bridge OAuth/provider entry + GLM API key. Run 'workflow-copilot guide' for the exact UI steps.")
    return 0


def setup(root: Path, open_vscode: bool) -> int:
    failures = 0
    print("==> Codex CLI fallback health")
    codex_rc = run([tool("workflow-codex"), "doctor"], cwd=root, required=False)
    if codex_rc:
        print("Codex CLI fallback needs repair; installing a user-local WSL copy.")
        run([tool("workflow-codex"), "repair"], cwd=root, required=False)
    print("\n==> Copilot Chat unified model UI")
    failures += run([tool("workflow-copilot"), "configure", "--workspace", str(root)], cwd=root)
    print("\n==> Doctor suite")
    failures += doctor(root)
    if open_vscode and shutil.which("code"):
        print("\n==> VS Code")
        run(["code", str(root)], cwd=root, required=False)
    if not failures:
        print("\nNext manual step: workflow-copilot guide")
    return 1 if failures else 0


def main() -> int:
    ap = argparse.ArgumentParser(description="One-command setup/verification for Copilot Chat + Codex Bridge + GLM + shared SGLang workflow")
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("setup")
    p.add_argument("--workspace")
    p.add_argument("--no-open-vscode", action="store_true")
    d = sub.add_parser("doctor")
    d.add_argument("--workspace")
    args = ap.parse_args()
    root = workspace(args.workspace)
    if args.command == "doctor":
        return doctor(root)
    return setup(root, not args.no_open_vscode)


if __name__ == "__main__":
    raise SystemExit(main())
