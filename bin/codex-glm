#!/usr/bin/env python3
"""Launch Codex with the configured GLM Coding Plan profile."""
from __future__ import annotations
import argparse, os, shlex
from pathlib import Path

CONFIG=Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'sglang-workflow'/'models.env'

def load_env():
    if not CONFIG.is_file(): return
    for raw in CONFIG.read_text(encoding='utf-8').splitlines():
        line=raw.strip()
        if not line or line.startswith('#') or '=' not in line: continue
        k,v=line.split('=',1); k=k.strip(); v=v.strip()
        if k in os.environ: continue
        if v[:1] in {'"',"'"}:
            try:v=shlex.split(v)[0]
            except Exception: pass
        os.environ[k]=v

def main():
    load_env()
    p=argparse.ArgumentParser(add_help=False)
    p.add_argument('--effort',choices=['low','high','max'],default='high')
    p.add_argument('-h','--help',action='store_true')
    args,rest=p.parse_known_args()
    if args.help:
        print('Usage: codex-glm [--effort low|high|max] [codex arguments...]')
        return 0
    if os.environ.get('AI_GLM_ENABLED','0').lower() not in {'1','true','yes','on'}:
        raise SystemExit('GLM is not enabled. Run: workflow-configure --enable-glm')
    if not os.environ.get('AI_GLM_API_KEY','').strip():
        raise SystemExit(f'GLM key missing in {CONFIG}. Run: workflow-configure --enable-glm')
    region=os.environ.get('AI_GLM_REGION','china').lower()
    if region not in {'china','global'}: raise SystemExit(f'Invalid AI_GLM_REGION={region!r}')
    profile=f'glm-{region}-{args.effort}'
    os.execvp('codex',['codex','--profile',profile,*rest])

if __name__=='__main__': raise SystemExit(main())
