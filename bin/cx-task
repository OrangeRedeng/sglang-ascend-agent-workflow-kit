#!/usr/bin/env bash
set -euo pipefail
kind="${1:-dev}"
shift || true

case "$kind" in
  desc|description|metadata|docs)
    profile="sglang-lite" ;;
  conflict|conflicts|comments|bug|refactor|dev)
    profile="sglang" ;;
  review|feature|ascend|npu|cuda|distributed|perf)
    profile="sglang-hard" ;;
  deep|xhigh)
    profile="sglang-xhigh" ;;
  *)
    echo "Unknown task kind: $kind" >&2
    echo "Kinds: desc metadata docs conflict comments bug refactor review feature ascend npu distributed perf deep" >&2
    exit 2 ;;
esac

exec codex --profile "$profile" "$@"
