#!/usr/bin/env python3
"""Configure primary and optional model backends for the SGLang workflow kit."""
from __future__ import annotations

import argparse
from getpass import getpass
from pathlib import Path
import os
import shlex

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "sglang-workflow" / "models.env"
VALID_PRIMARY = {"codex", "local", "cheap", "strong", "none"}
SLOTS = ("local", "cheap", "strong")

# Presets contain only public endpoint/model metadata. Secrets are always entered
# separately and stored only in ~/.config/sglang-workflow/models.env (0600).
PRESETS: dict[str, dict[str, object]] = {
    "deepseek": {
        "label": "DeepSeek V4",
        "base": "https://api.deepseek.com",
        "cheap_model": "deepseek-v4-flash",
