#!/usr/bin/env python3
"""Configure Codex provider policy and optional OpenCode workers."""
from __future__ import annotations
import argparse, os, shlex
from getpass import getpass
from pathlib import Path

CONFIG=Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'sglang-workflow'/'models.env'
VALID_PRIMARY={'codex','local','cheap','strong','none'}
SLOTS=('local','cheap','strong')
PRESETS={
 'deepseek':{'label':'DeepSeek V4','base':'https://api.deepseek.com','cheap_model':'deepseek-v4-flash','strong_model':'deepseek-v4-pro','context':1048576,'output':65536},
 'zai-free':{'label':'Z.AI free GLM','base':'https://api.z.ai/api/paas/v4','model':'glm-4.7-flash','context':204800,'output':131072},
 'kimi-code':{'label':'Kimi Code membership','base':'https://api.kimi.com/coding/v1','model':'k3-256k','context':262144,'output':65536},
 'minimax':{'label':'MiniMax API','base':'https://api.minimax.io/v1','model':'MiniMax-M2.7','context':204800,'output':32768},
 'openrouter-free':{'label':'OpenRouter free-model router','base':'https://openrouter.ai/api/v1','model':'openrouter/free','context':200000,'output':16384},
 'alibaba-payg':{'label':'Alibaba Model Studio Qwen Coder PAYG','base':'https://dashscope-intl.aliyuncs.com/compatible-mode/v1','cheap_model':'qwen3-coder-flash','strong_model':'qwen3-coder-plus','context':1000000,'output':65536},
 'alibaba-coding':{'label':'Alibaba Cloud Coding Plan (international)','base':'https://coding-intl.dashscope.aliyuncs.com/v1','model':'qwen3-coder-plus','context':1048576,'output':65536},
}
GLM_BASE={'china':'https://open.bigmodel.cn/api/v1','global':'https://api.z.ai/api/v1'}

def read_env(path):
    data={}
    if not path.exists(): return data
    for raw in path.read_text(encoding='utf-8').splitlines():
        line=raw.strip()
        if not line or line.startswith('#') or '=' not in line: continue
        k,v=line.split('=',1); k=k.strip(); v=v.strip()
        if v[:1] in {'"',"'"}:
            try:v=shlex.split(v)[0]
            except Exception:pass
        data[k]=v
    return data

def ask_yes_no(prompt,default):
    suffix=' [Y/n] ' if default else ' [y/N] '
    while True:
        v=input(prompt+suffix).strip().lower()
        if not v:return default
        if v in {'y','yes'}:return True
        if v in {'n','no'}:return False
        print('Please answer yes or no.')

def ask(prompt,default=''):
    suffix=f' [{default}] ' if default else ' '
    return input(prompt+suffix).strip() or default

def apply_preset(data,slot,name):
    p=PRESETS[name]; prefix=f'AI_{slot.upper()}_'; model=str(p.get(f'{slot}_model') or p.get('model') or '')
    data[prefix+'BASE_URL']=str(p['base']); data[prefix+'MODEL']=model; data[prefix+'CONTEXT']=str(p['context']); data[prefix+'OUTPUT']=str(p['output']); data[prefix+'NPM']='@ai-sdk/openai-compatible'

def configure_slot(data,slot,self_hosted=False,interactive=True,preset_name=None):
    prefix=f'AI_{slot.upper()}_'
    if preset_name: apply_preset(data,slot,preset_name)
    for suffix in ('BASE_URL','MODEL','API_KEY','NPM','CONTEXT','OUTPUT','PROVIDER_ID'):
        key=prefix+suffix
        if os.environ.get(key): data[key]=os.environ[key]
    if interactive and not self_hosted and not preset_name:
        names=list(PRESETS); print('\nProvider preset:')
        for i,n in enumerate(names,1): print(f'  {i}) {PRESETS[n]["label"]} ({n})')
        print(f'  {len(names)+1}) Custom OpenAI-compatible endpoint')
        choice=ask('Selection:',str(len(names)+1)); selected=None
        if choice.isdigit() and 1<=int(choice)<=len(names): selected=names[int(choice)-1]
        elif choice in PRESETS:selected=choice
        if selected: apply_preset(data,slot,selected)
    default_base=data.get(prefix+'BASE_URL','http://127.0.0.1:8000/v1' if self_hosted else '')
    if interactive:
        print(f'\nConfigure {slot} backend')
        data[prefix+'BASE_URL']=ask('OpenAI-compatible base URL:',default_base)
        data[prefix+'MODEL']=ask('Model ID:',data.get(prefix+'MODEL',''))
        data[prefix+'CONTEXT']=ask('Context window:',data.get(prefix+'CONTEXT','131072' if self_hosted else '262144'))
        data[prefix+'OUTPUT']=ask('Maximum output tokens:',data.get(prefix+'OUTPUT','16384' if self_hosted else '32768'))
        current=data.get(prefix+'API_KEY','not-needed' if self_hosted else '')
        if current and current!='not-needed': print('An API key is already configured. Empty keeps it.')
        secret=getpass('API key (hidden; empty keeps current/not-needed): ').strip()
        if secret:data[prefix+'API_KEY']=secret
        elif prefix+'API_KEY' not in data:data[prefix+'API_KEY']='not-needed' if self_hosted else ''
    else:
        data.setdefault(prefix+'BASE_URL',default_base); data.setdefault(prefix+'API_KEY','not-needed' if self_hosted else ''); data.setdefault(prefix+'CONTEXT','131072' if self_hosted else '262144'); data.setdefault(prefix+'OUTPUT','16384' if self_hosted else '32768')
    data.setdefault(prefix+'NPM','@ai-sdk/openai-compatible')
    if not data.get(prefix+'BASE_URL') or not data.get(prefix+'MODEL'): raise SystemExit(f'{slot} backend is incomplete: set {prefix}BASE_URL and {prefix}MODEL')
    if not self_hosted and not data.get(prefix+'API_KEY'): raise SystemExit(f'{slot} backend requires {prefix}API_KEY')

def configure_glm(data,*,interactive=True,region=None,routing=None,enable=True):
    if not enable:
        data['AI_GLM_ENABLED']='0'; return
    region=(region or os.environ.get('AI_GLM_REGION') or data.get('AI_GLM_REGION') or 'china').lower()
    if region not in GLM_BASE: raise SystemExit('GLM region must be china or global')
    route=(routing or os.environ.get('AI_CODEX_ROUTING') or data.get('AI_CODEX_ROUTING') or 'balanced').lower()
    if route not in {'balanced','openai','glm'}: raise SystemExit('AI_CODEX_ROUTING must be balanced, openai, or glm')
    model=os.environ.get('AI_GLM_MODEL') or data.get('AI_GLM_MODEL') or 'glm-5.3'
    key=os.environ.get('AI_GLM_API_KEY') or data.get('AI_GLM_API_KEY','')
    if interactive:
        print('\nConfigure GLM Coding Plan for Codex')
        region=ask('Plan region (china/global):',region).lower()
        if region not in GLM_BASE: raise SystemExit('Invalid GLM region')
        model=ask('Model ID:',model)
        route=ask('Codex routing (balanced/openai/glm):',route).lower()
        if key: print('A GLM Coding Plan key is already configured. Empty keeps it.')
        secret=getpass('GLM Coding Plan API key (hidden; empty keeps current): ').strip()
        if secret:key=secret
    if not key: raise SystemExit('GLM Coding Plan API key is required (AI_GLM_API_KEY).')
    data.update({'AI_GLM_ENABLED':'1','AI_GLM_REGION':region,'AI_GLM_BASE_URL':GLM_BASE[region],'AI_GLM_MODEL':model,'AI_GLM_API_KEY':key,'AI_CODEX_ROUTING':route})

def write_env(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    order=['AI_PRIMARY_HARNESS','AI_PRIMARY_PROVIDER','AI_PRIMARY_BACKEND','AI_ROUTING_MODE','AI_ENABLE_CODEX_FALLBACK','AI_CODEX_ROUTING','AI_GLM_ENABLED','AI_GLM_REGION','AI_GLM_BASE_URL','AI_GLM_MODEL','AI_GLM_API_KEY','AI_LOCAL_BASE_URL','AI_LOCAL_MODEL','AI_LOCAL_API_KEY','AI_LOCAL_NPM','AI_LOCAL_PROVIDER_ID','AI_LOCAL_CONTEXT','AI_LOCAL_OUTPUT','AI_CHEAP_BASE_URL','AI_CHEAP_MODEL','AI_CHEAP_API_KEY','AI_CHEAP_NPM','AI_CHEAP_PROVIDER_ID','AI_CHEAP_CONTEXT','AI_CHEAP_OUTPUT','AI_STRONG_BASE_URL','AI_STRONG_MODEL','AI_STRONG_API_KEY','AI_STRONG_NPM','AI_STRONG_PROVIDER_ID','AI_STRONG_CONTEXT','AI_STRONG_OUTPUT','AI_OPENCODE_AUTO']
    lines=['# SGLang workflow model configuration.','# Generated by workflow-configure. Keep this file private.','']
    for key in order:
        if key in data:
            v=data[key]
            if any(ch.isspace() for ch in v) or any(ch in v for ch in "#'\""):v=shlex.quote(v)
            lines.append(f'{key}={v}')
    path.write_text('\n'.join(lines)+'\n',encoding='utf-8'); os.chmod(path,0o600)

def print_presets():
    for name,p in PRESETS.items(): print(f"{name:18} {p['label']}\n  base: {p['base']}\n  cheap: {p.get('cheap_model') or p.get('model') or ''}\n  strong: {p.get('strong_model') or p.get('model') or ''}")

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--primary',choices=sorted(VALID_PRIMARY)); ap.add_argument('--routing',choices=['primary','hybrid']); ap.add_argument('--codex-fallback',choices=['yes','no']); ap.add_argument('--slot',choices=SLOTS); ap.add_argument('--preset',choices=sorted(PRESETS)); ap.add_argument('--enable-glm',action='store_true'); ap.add_argument('--disable-glm',action='store_true'); ap.add_argument('--glm-region',choices=['china','global']); ap.add_argument('--glm-routing',choices=['balanced','openai','glm']); ap.add_argument('--glm-model'); ap.add_argument('--list-presets',action='store_true'); ap.add_argument('--non-interactive',action='store_true'); args=ap.parse_args()
    if args.list_presets: print_presets(); return 0
    data=read_env(CONFIG); data.setdefault('AI_PRIMARY_HARNESS','codex'); data.setdefault('AI_PRIMARY_PROVIDER','openai'); data.setdefault('AI_PRIMARY_BACKEND','codex'); data.setdefault('AI_ROUTING_MODE','primary'); data.setdefault('AI_ENABLE_CODEX_FALLBACK','0'); data.setdefault('AI_CODEX_ROUTING','balanced'); data.setdefault('AI_GLM_ENABLED','0'); data.setdefault('AI_GLM_REGION','china'); data.setdefault('AI_GLM_MODEL','glm-5.3'); data.setdefault('AI_OPENCODE_AUTO','1')
    if args.glm_model: data['AI_GLM_MODEL']=args.glm_model
    if args.slot:
        configure_slot(data,args.slot,self_hosted=args.slot=='local',interactive=not args.non_interactive,preset_name=args.preset); write_env(CONFIG,data); print(f'Configuration saved: {CONFIG}'); return 0
    if args.enable_glm or args.disable_glm:
        configure_glm(data,interactive=not args.non_interactive,region=args.glm_region,routing=args.glm_routing,enable=not args.disable_glm); write_env(CONFIG,data); print(f'Configuration saved: {CONFIG}'); return 0
    if args.non_interactive:
        if args.primary:data['AI_PRIMARY_BACKEND']=args.primary; data['AI_PRIMARY_HARNESS']='codex' if args.primary=='codex' else ('none' if args.primary=='none' else 'opencode'); data['AI_PRIMARY_PROVIDER']='openai' if args.primary=='codex' else args.primary
        if args.routing:data['AI_ROUTING_MODE']=args.routing
        if args.codex_fallback:data['AI_ENABLE_CODEX_FALLBACK']='1' if args.codex_fallback=='yes' else '0'
        if args.glm_region:data['AI_GLM_REGION']=args.glm_region; data['AI_GLM_BASE_URL']=GLM_BASE[args.glm_region]
        if args.glm_routing:data['AI_CODEX_ROUTING']=args.glm_routing
        write_env(CONFIG,data); print(f'Configuration saved: {CONFIG}'); return 0
    print('SGLang workflow model configuration')
    use_codex=ask_yes_no('Use Codex / OpenAI extension as the primary harness?',data.get('AI_PRIMARY_HARNESS','codex')=='codex')
    if use_codex:
        data['AI_PRIMARY_HARNESS']='codex'; data['AI_PRIMARY_PROVIDER']='openai'; data['AI_PRIMARY_BACKEND']='codex'
        enable=ask_yes_no('Enable GLM Coding Plan as an additional Codex provider?',data.get('AI_GLM_ENABLED')=='1')
        configure_glm(data,interactive=True,enable=enable)
    else:
        print('1) Self-hosted OpenAI-compatible model\n2) External API strong slot\n3) External API cheap slot\n4) No primary model backend')
        choice=ask('Selection:','1'); primary={'1':'local','2':'strong','3':'cheap','4':'none'}.get(choice,'')
        if not primary: raise SystemExit('Invalid selection')
        data['AI_PRIMARY_BACKEND']=primary; data['AI_PRIMARY_HARNESS']='none' if primary=='none' else 'opencode'; data['AI_PRIMARY_PROVIDER']=primary
        if primary in SLOTS: configure_slot(data,primary,self_hosted=primary=='local')
    if ask_yes_no('Enable hybrid automatic routing between configured backends?',data.get('AI_ROUTING_MODE')=='hybrid'): data['AI_ROUTING_MODE']='hybrid'
    else:data['AI_ROUTING_MODE']='primary'
    write_env(CONFIG,data); print(f'Configuration saved: {CONFIG}'); return 0
if __name__=='__main__': raise SystemExit(main())
