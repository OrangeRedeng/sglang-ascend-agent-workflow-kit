#!/usr/bin/env python3
"""Task router for the SGLang + Ascend workflow kit.

v0.3 keeps Codex as the preferred harness and separates the Codex provider policy
(OpenAI vs GLM Coding Plan) from optional OpenCode external worker tiers.
"""
from __future__ import annotations
import json, os, shlex, shutil, subprocess, sys
from pathlib import Path

CONFIG=Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'sglang-workflow'/'models.env'
EXTERNAL_TIERS=('local','cheap','strong')
OPENAI_PROFILES={'codex-lite':'sglang-lite','codex':'sglang','codex-hard':'sglang-hard','codex-xhigh':'sglang-xhigh'}
GLM_TIERS=('glm-low','glm','glm-max')
KINDS={
 'desc','description','metadata','docs','log','logs','search','simple-ci','ci','conflict','conflicts','comments','bug','refactor','dev','review','feature','verify','ascend','npu','cuda','distributed','perf','kernel','deep','xhigh'
}
HARD_OPENAI={'verify','ascend','npu','cuda','distributed','perf','kernel','deep','xhigh'}
HYBRID_EXTERNAL={
 'desc':['local','cheap','strong'],'description':['local','cheap','strong'],'metadata':['local','cheap','strong'],'docs':['local','cheap','strong'],'log':['local','cheap','strong'],'logs':['local','cheap','strong'],'search':['local','cheap','strong'],'simple-ci':['local','cheap','strong'],
 'ci':['cheap','local','strong'],'conflict':['cheap','local','strong'],'conflicts':['cheap','local','strong'],'comments':['cheap','local','strong'],'bug':['cheap','local','strong'],'refactor':['cheap','strong','local'],'dev':['cheap','strong','local'],'review':['strong','cheap','local'],'feature':['strong','cheap','local'],'verify':['strong','local','cheap'],'ascend':['strong','local','cheap'],'npu':['strong','local','cheap'],'cuda':['strong','local','cheap'],'distributed':['strong','local','cheap'],'perf':['strong','local','cheap'],'kernel':['strong','local','cheap'],'deep':['strong','local','cheap'],'xhigh':['strong','local','cheap']
}

def usage():
    print('Usage: ai-task [--tier auto|primary|local|cheap|strong|glm-low|glm|glm-max|codex-lite|codex|codex-hard|codex-xhigh] [--dry-run] <kind> [request...]',file=sys.stderr)
    print('Kinds: '+' '.join(sorted(KINDS)),file=sys.stderr)

def load_env_file(path:Path)->None:
    if not path.is_file(): return
    exported=set(os.environ); parsed={}
    for raw in path.read_text(encoding='utf-8').splitlines():
        line=raw.strip()
        if not line or line.startswith('#') or '=' not in line: continue
        k,v=line.split('=',1); k=k.strip(); v=v.strip()
        if v[:1] in {'"',"'"}:
            try:v=shlex.split(v)[0]
            except Exception: pass
        parsed[k]=v
    for k,v in parsed.items():
        if k not in exported: os.environ[k]=v

def bool_env(name:str,default=False)->bool:
    raw=os.environ.get(name)
    return default if raw is None else raw.strip().lower() in {'1','true','yes','on'}

def primary_backend()->str:
    # v0.3 harness/provider fields take precedence; legacy AI_PRIMARY_BACKEND remains supported.
    harness=os.environ.get('AI_PRIMARY_HARNESS','').strip().lower()
    provider=os.environ.get('AI_PRIMARY_PROVIDER','').strip().lower()
    if harness:
        if harness=='codex': return 'codex'
        if harness=='opencode' and provider in EXTERNAL_TIERS: return provider
        if harness=='none': return 'none'
        raise SystemExit(f'Invalid AI_PRIMARY_HARNESS={harness!r} / AI_PRIMARY_PROVIDER={provider!r} in {CONFIG}')
    value=os.environ.get('AI_PRIMARY_BACKEND','codex').strip().lower() or 'codex'
    if value not in {'codex','local','cheap','strong','none'}: raise SystemExit(f'Invalid AI_PRIMARY_BACKEND={value!r} in {CONFIG}')
    return value

def routing_mode()->str:
    value=os.environ.get('AI_ROUTING_MODE','primary').strip().lower() or 'primary'
    if value not in {'primary','hybrid'}: raise SystemExit(f'Invalid AI_ROUTING_MODE={value!r}')
    return value

def codex_policy()->str:
    value=os.environ.get('AI_CODEX_ROUTING','balanced').strip().lower() or 'balanced'
    if value not in {'balanced','openai','glm'}: raise SystemExit(f'Invalid AI_CODEX_ROUTING={value!r}')
    return value

def glm_enabled()->bool:
    return bool_env('AI_GLM_ENABLED',False) and bool(os.environ.get('AI_GLM_API_KEY','').strip())

def glm_region()->str:
    region=os.environ.get('AI_GLM_REGION','china').strip().lower() or 'china'
    if region not in {'china','global'}: raise SystemExit(f'Invalid AI_GLM_REGION={region!r}')
    return region

def openai_tier_for_kind(kind:str)->str:
    if kind in {'desc','description','metadata','docs','log','logs','search'}: return 'codex-lite'
    if kind in {'review','verify','ascend','npu','cuda','distributed','perf','kernel'}: return 'codex-hard'
    if kind in {'deep','xhigh'}: return 'codex-xhigh'
    return 'codex'

def glm_tier_for_kind(kind:str)->str:
    if kind in {'desc','description','metadata','docs','log','logs','search','simple-ci'}: return 'glm-low'
    if kind in {'review','deep','xhigh'}: return 'glm-max'
    return 'glm'

def codex_route(kind:str)->str:
    policy=codex_policy()
    if policy=='openai': return openai_tier_for_kind(kind)
    if policy=='glm': return glm_tier_for_kind(kind) if glm_enabled() else openai_tier_for_kind(kind)
    if kind in HARD_OPENAI: return openai_tier_for_kind(kind)
    return glm_tier_for_kind(kind) if glm_enabled() else openai_tier_for_kind(kind)

def tier_settings(tier:str):
    prefix=f'AI_{tier.upper()}_'; base=os.environ.get(prefix+'BASE_URL','').strip(); model=os.environ.get(prefix+'MODEL','').strip()
    if not base or not model: return None
    try: context=int(os.environ.get(prefix+'CONTEXT','131072')); output=int(os.environ.get(prefix+'OUTPUT','16384'))
    except ValueError: raise SystemExit(f'Invalid {prefix}CONTEXT/OUTPUT')
    return {'base':base,'model':model,'key':os.environ.get(prefix+'API_KEY','').strip() or 'not-needed','npm':os.environ.get(prefix+'NPM','').strip() or '@ai-sdk/openai-compatible','provider':os.environ.get(prefix+'PROVIDER_ID',f'kit-{tier}').strip(),'context':context,'output':output}

def request_text(kind,parts):
    user=' '.join(parts).strip()
    if kind=='review' and len(parts)==1 and parts[0].isdigit(): user=f'Review PR #{parts[0]}. Report only.'
    elif not user: user=f'Perform the {kind} task for the current worktree.'
    policy=(f'Workflow task kind: {kind}. Follow AGENTS.override.md and applicable .agents/skills. Use targeted Git/rg/Semble retrieval when available; reduce large logs before reading raw content. Do not commit or push. Before code-changing work, run .codex/scripts/resolve-handoff.py --json when installed. For Ascend/NPU/HCCL/NPUGraph/performance/kernel work, establish the version/runtime/workload baseline before drawing conclusions. If required semantics cannot be established confidently, report uncertainty rather than guessing.')
    return policy+'\n\nUser request: '+user

def build_inline_config(cfg):
    model=str(cfg['model']); provider=str(cfg['provider'])
    return json.dumps({'$schema':'https://opencode.ai/config.json','provider':{provider:{'npm':cfg['npm'],'name':f'SGLang workflow {provider}','options':{'baseURL':cfg['base'],'apiKey':'{env:WORKFLOW_MODEL_API_KEY}'},'models':{model:{'name':model,'limit':{'context':cfg['context'],'output':cfg['output']}}}}}},separators=(',',':'))

def workflow_consumer():
    return primary_backend() if primary_backend()!='none' else 'next-agent'

def run_external(tier,kind,parts,dry):
    cfg=tier_settings(tier)
    if cfg is None:return 125
    model_ref=f"{cfg['provider']}/{cfg['model']}"; cmd=['opencode','run','--model',model_ref,'--dir',str(Path.cwd())]
    if os.environ.get('AI_OPENCODE_AUTO','1').strip().lower() not in {'0','false','no'}: cmd.append('--auto')
    cmd.append(request_text(kind,parts)); env=os.environ.copy(); env['OPENCODE_CONFIG_CONTENT']=build_inline_config(cfg); env['WORKFLOW_MODEL_API_KEY']=str(cfg['key']); env['WORKFLOW_PRODUCER']=f'opencode:{model_ref}'; env['WORKFLOW_CONSUMER']=workflow_consumer()
    print(f'ai-task route: {kind} -> {tier} ({model_ref})',file=sys.stderr)
    if dry: print('DRY RUN:',shlex.join(cmd)); print('provider base:',cfg['base']); return 0
    if shutil.which('opencode') is None: print('ai-task: OpenCode is not installed; external tier unavailable',file=sys.stderr); return 125
    return subprocess.run(cmd,env=env).returncode

def codex_request(kind,parts):
    return [f'Review PR #{parts[0]}. Report only.'] if kind=='review' and len(parts)==1 and parts[0].isdigit() else parts

def run_codex(tier,kind,parts,dry):
    if tier in OPENAI_PROFILES:
        profile=OPENAI_PROFILES[tier]; provider='openai'
    else:
        if not glm_enabled(): return 125
        effort={'glm-low':'low','glm':'high','glm-max':'max'}[tier]; profile=f'glm-{glm_region()}-{effort}'; provider='glm'
    cmd=['codex','--profile',profile,*codex_request(kind,parts)]
    print(f'ai-task route: {kind} -> {tier} ({profile})',file=sys.stderr)
    if dry: print('DRY RUN:',shlex.join(cmd)); return 0
    if shutil.which('codex') is None: print('ai-task: Codex CLI is not installed',file=sys.stderr); return 125
    env=os.environ.copy(); env['WORKFLOW_PRODUCER']=f'codex:{provider}'; env['WORKFLOW_CONSUMER']=workflow_consumer(); return subprocess.run(cmd,env=env).returncode

def dedupe(items):
    out=[]
    for i in items:
        if i not in out: out.append(i)
    return out

def automatic_route(kind):
    primary=primary_backend(); mode=routing_mode(); selected=codex_route(kind)
    if mode=='primary': return [selected] if primary=='codex' else ([primary] if primary in EXTERNAL_TIERS else [])
    candidates=list(HYBRID_EXTERNAL[kind])
    if primary=='codex':
        if kind in HARD_OPENAI: return dedupe([selected,*candidates])
        candidates.append(selected)
    elif primary in EXTERNAL_TIERS:
        candidates=[primary,*candidates] if kind in HARD_OPENAI else [*candidates,primary]
        if bool_env('AI_ENABLE_CODEX_FALLBACK',False): candidates.append(selected)
    elif bool_env('AI_ENABLE_CODEX_FALLBACK',False): candidates.append(selected)
    return dedupe(candidates)

def main():
    load_env_file(CONFIG); args=sys.argv[1:]; tier='auto'; dry=False
    while args and args[0].startswith('--'):
        if args[0]=='--dry-run': dry=True; args=args[1:]; continue
        if args[0]=='--tier' and len(args)>=2: tier=args[1]; args=args[2:]; continue
        if args[0].startswith('--tier='): tier=args[0].split('=',1)[1]; args=args[1:]; continue
        usage(); return 2
    if not args: usage(); return 2
    kind,parts=args[0].lower(),args[1:]
    if kind not in KINDS: print(f'Unknown task kind: {kind}',file=sys.stderr); usage(); return 2
    allowed={'auto','primary',*EXTERNAL_TIERS,*OPENAI_PROFILES,*GLM_TIERS}
    if tier not in allowed: print(f'Unknown tier: {tier}',file=sys.stderr); return 2
    if tier=='auto': route=automatic_route(kind)
    elif tier=='primary':
        p=primary_backend(); route=[codex_route(kind)] if p=='codex' else ([p] if p!='none' else [])
    else: route=[tier]
    for selected in route:
        rc=run_codex(selected,kind,parts,dry) if selected in OPENAI_PROFILES or selected in GLM_TIERS else run_external(selected,kind,parts,dry)
        if rc==125: continue
        return rc
    print('ai-task: no configured backend is available for this route',file=sys.stderr); print(f'Run workflow-configure or edit {CONFIG}.',file=sys.stderr); return 3
if __name__=='__main__': raise SystemExit(main())
