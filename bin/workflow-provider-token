#!/usr/bin/env python3
"""Print one provider token from the private workflow models.env file."""
from __future__ import annotations
import os, shlex, sys
from pathlib import Path

CONFIG=Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'sglang-workflow'/'models.env'
KEYS={'glm':'AI_GLM_API_KEY','cheap':'AI_CHEAP_API_KEY','strong':'AI_STRONG_API_KEY','local':'AI_LOCAL_API_KEY'}

def read_env(path:Path)->dict[str,str]:
    data={}
    if not path.is_file(): return data
    for raw in path.read_text(encoding='utf-8').splitlines():
        line=raw.strip()
        if not line or line.startswith('#') or '=' not in line: continue
        k,v=line.split('=',1); v=v.strip()
        if v[:1] in {'"',"'"}:
            try:v=shlex.split(v)[0]
            except Exception:pass
        data[k.strip()]=v
    return data

def main()->int:
    if len(sys.argv)!=2 or sys.argv[1] not in KEYS:
        print('usage: workflow-provider-token glm|local|cheap|strong',file=sys.stderr); return 2
    env_name=KEYS[sys.argv[1]]
    value=os.environ.get(env_name) or read_env(CONFIG).get(env_name,'')
    if not value or value=='not-needed':
        if value=='not-needed': print(value); return 0
        print(f'{env_name} is not configured in {CONFIG}',file=sys.stderr); return 1
    print(value); return 0
if __name__=='__main__': raise SystemExit(main())
