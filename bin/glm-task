#!/usr/bin/env bash
set -euo pipefail
effort="high"
if [[ "${1:-}" == "--effort" ]]; then effort="${2:?missing effort}"; shift 2; fi
case "$effort" in
  low) tier=glm-low ;;
  high) tier=glm ;;
  max) tier=glm-max ;;
  *) echo "effort must be low, high, or max" >&2; exit 2 ;;
esac
exec ai-task --tier "$tier" "$@"
