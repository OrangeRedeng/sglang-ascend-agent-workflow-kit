{
  "description": "SGLang Ascend workflow: handoff discovery, prompt guard, and measured session retrieval budget.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_start.py\"",
            "timeout": 8,
            "statusMessage": "Resolving workflow handoff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/prompt_guard.py\"",
            "timeout": 8,
            "statusMessage": "Checking prompt workflow"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/post_tool_budget.py\"",
            "timeout": 5,
            "statusMessage": "Tracking retrieval budget"
          }
        ]
      }
    ]
  }
}
